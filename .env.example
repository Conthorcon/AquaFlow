# Mẫu tham khảo: app không tự đọc file .env; đặt biến trong terminal hoặc Vercel.
# Local có thể bỏ DATABASE_URL để tiếp tục dùng SQLite.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
AI_SERVER_URL=https://ai.example.com
AI_API_KEY=replace-with-the-same-secret-as-the-ai-server
AI_TIMEOUT_SECONDS=180
